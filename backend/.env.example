# Copy to backend/.env for local development. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Omit to use local SQLite. Docker Compose sets this to the Postgres service.
# DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter

# External providers (server-side only).
# Mapbox: routing + geocoding. Free tier token from https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=
# Open-Meteo: weather forecasts, no key required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2

LOG_LEVEL=INFO

# --- Production only (config.settings.prod, set in the host's dashboard) ---
# DJANGO_SETTINGS_MODULE=config.settings.prod   # already set in the Docker image
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CORS_ALLOWED_ORIGIN_REGEXES=^https://your-app-[a-z0-9-]+\.vercel\.app$   # preview deployments
# NUM_PROXIES=1            # trusted proxies in front of the app, for per-client rate limits
# GUNICORN_TIMEOUT=90
# WEB_CONCURRENCY=2
