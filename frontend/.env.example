# Copy to frontend/.env.local. Only VITE_* values are exposed to the browser - no secrets here.

# Leave empty in dev (Vite proxies /api to Django). Set to the deployed API origin in production.
VITE_API_BASE_URL=

# MapLibre style URL. Defaults to OpenFreeMap "liberty" (no key required).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
